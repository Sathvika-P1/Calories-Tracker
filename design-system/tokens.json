{
  "color-fg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.102, 0.1216, 0.1412], "hex": "#1a1f24" },
    "$description": "Primary text color on light backgrounds."
  },
  "color-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "App background color."
  },
  "color-surface": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9647, 0.9725], "hex": "#f4f6f8" },
    "$description": "Raised surface background, e.g. cards."
  },
  "color-muted": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.3569, 0.4, 0.4392], "hex": "#5b6670" },
    "$description": "Secondary text color."
  },
  "color-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.1137, 0.4353, 0.2588], "hex": "#1d6f42" },
    "$description": "Brand accent for primary actions."
  },
  "color-primary-hover": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.0863, 0.3333, 0.2], "hex": "#165533" },
    "$description": "Hover/active state of primary accent."
  },
  "color-on-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Text/icon color on top of primary accent."
  },
  "color-border": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.8392, 0.8588, 0.8745], "hex": "#d6dbdf" },
    "$description": "Default border color for cards, inputs, dividers."
  },
  "color-danger": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.7020, 0.149, 0.1176], "hex": "#b3261e" },
    "$description": "Destructive or error state color."
  },
  "color-success": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.1137, 0.4353, 0.2588], "hex": "#1d6f42" },
    "$description": "Positive/success state color."
  },
  "color-chip-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.8941, 0.9373, 0.9098], "hex": "#e4efe8" },
    "$description": "Background for chip/tag elements."
  },
  "color-focus-ring": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.1137, 0.4353, 0.2588], "hex": "#1d6f42" },
    "$description": "Outline color for keyboard focus indication."
  },
  "space-1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
  "space-2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
  "space-3": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
  "space-4": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
  "radius-sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
  "radius-md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
  "radius-lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
  "font-size-xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
  "font-size-sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
  "font-size-md": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
  "font-size-lg": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
  "border-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
  "focus-ring-width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
  "size-swatch": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
  "size-swatch-bar": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
  "width-swatch": { "$type": "dimension", "$value": { "value": 160, "unit": "px" } },
  "width-form": { "$type": "dimension", "$value": { "value": 320, "unit": "px" } },
  "width-list": { "$type": "dimension", "$value": { "value": 480, "unit": "px" } },
  "width-content": { "$type": "dimension", "$value": { "value": 960, "unit": "px" } },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "'Inter', 'Segoe UI', system-ui, sans-serif"
  },
  "font-weight-regular": { "$type": "fontWeight", "$value": 400 },
  "font-weight-bold": { "$type": "fontWeight", "$value": 700 },
  "line-height-base": { "$type": "number", "$value": 1.5 },
  "button-primary-background": { "$type": "color", "$value": "{color-primary}" },
  "button-primary-text": { "$type": "color", "$value": "{color-on-primary}" },
  "button-primary-border": { "$type": "color", "$value": "{color-primary}" },
  "button-secondary-background": { "$type": "color", "$value": "{color-bg}" },
  "button-secondary-text": { "$type": "color", "$value": "{color-primary}" },
  "button-secondary-border": { "$type": "color", "$value": "{color-primary}" },
  "card-default-background": { "$type": "color", "$value": "{color-surface}" },
  "card-default-border": { "$type": "color", "$value": "{color-border}" },
  "card-default-radius": { "$type": "dimension", "$value": "{radius-md}" },
  "card-default-padding": { "$type": "dimension", "$value": "{space-3}" },
  "chip-default-background": { "$type": "color", "$value": "{color-chip-bg}" },
  "chip-default-text": { "$type": "color", "$value": "{color-primary}" },
  "input-default-background": { "$type": "color", "$value": "{color-bg}" },
  "input-default-border": { "$type": "color", "$value": "{color-border}" },
  "input-default-text": { "$type": "color", "$value": "{color-fg}" }
}
